# Codex MCP-Konfig für n8n-mcp.
# Kopieren nach ~/.codex/config.toml (global) ODER als .codex/config.toml im Projekt
# (Projekt-Scope funktioniert nur bei "trusted projects").
# N8N_API_URL: Adresse eurer n8n in one.intelligence (nur der Anfang, ohne / am Ende).
# N8N_API_KEY: dein eigener API-Schlüssel aus n8n (Settings, n8n API, Create API Key).
# ⚠️ Die echte Datei NICHT committen (enthält deinen API-Key). Sie steht in .gitignore.

[mcp_servers.n8n-mcp]
command = "npx"
args = ["-y", "n8n-mcp"]

[mcp_servers.n8n-mcp.env]
N8N_API_URL = "https://DEINE-N8N-ADRESSE"
N8N_API_KEY = "DEIN_N8N_API_KEY"
# Optionaler dritter Schluessel: ohne ihn kann Claude Workflows ohne Webhook nicht starten
# (alle mit Zeitplan). Nur falls eure n8n in one.intelligence den MCP-Zugang anbietet, sonst Zeile loeschen.
N8N_MCP_ACCESS_TOKEN = "DEIN_MCP_ACCESS_TOKEN"
MCP_MODE = "stdio"
LOG_LEVEL = "error"
DISABLE_CONSOLE_OUTPUT = "true"
