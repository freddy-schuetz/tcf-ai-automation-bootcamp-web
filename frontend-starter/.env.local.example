# Env-Variablen des Frontend-Starters (nur Platzhalter, keine echten Werte committen).
# Lokal: nach .env.local kopieren und ausfüllen. Beim Veröffentlichen über buildbar
# gibt Claude die Werte beim Deploy-Aufruf mit (je Zeile KEY=VALUE).
# Die Supabase-Zugänge stehen im Bootcamp-Zugangsbereich: https://tcf.buildbar.de/#zugang

# n8n-Basis-URL (Muster A: Webhook-Aufruf aus dem Frontend)
# Adresse eurer n8n in one.intelligence
NEXT_PUBLIC_N8N_BASE=https://n8n.oi.destination.one

# Pfad des Beispiel-Webhooks (ohne /webhook/). Leer = "hello".
# Mit eigenem Kürzel, z. B. mk-hello (Pfade gelten für die ganze n8n in one.intelligence).
NEXT_PUBLIC_HELLO_PATH=

# KI-Chat (Muster C, optional). Im TCF-Bootcamp gibt es dafür keinen Schlüssel, KI läuft
# über n8n mit one.intelligence. Mit eigenem Anthropic-Schlüssel: /api/chat hat KEINEN Login
# (offener KI-Proxy), nur mit Schutz einschalten, Key nur serverseitig, nie als NEXT_PUBLIC_*.
CHAT_ENABLED=false
ANTHROPIC_API_KEY=

# TCF-Supabase (nur falls die App Datenbank, Login oder Dateien braucht):
# Project-URL und anon-Key aus dem Zugangsbereich. Den service_role-Key NIE hier
# eintragen, er gehört nur serverseitig in n8n.
# Aus dem Frontend nur Tabellen mit aktivierter Row Level Security (RLS) und passenden
# Policies ansprechen. Ohne RLS die Daten nur über n8n lesen und schreiben.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
